eureka:
  client:
    fetch-registry: true
    register-with-eureka: true
    service-url:
      defaultZone: http://localhost:8761/eureka
  instance:
    prefer-ip-address: true
management:
  endpoint:
    health:
      show-details: always
  endpoints:
    web:
      exposure:
        include: health
  health:
    circuitbreakers:
      enabled: true
okta:
  oauth2:
    audience: api://default
    issuer: https://<YOUR_OKTA_DOMAIN>/oauth2/default
resilience4j:
  circuitbreaker:
    instances:
      ratingHotelBreaker:
        automaticTransitionFromOpenToHalfOpenEnabled: true
        eventConsumerBufferSize: 10
        failureRateThreshold: 50
        minimumNumberOfCalls: 5
        permittedNumberOfCallsInHalfOpenState: 3
        registerHealthIndicator: true
        slidingWindowSize: 10
        slidingWindowType: COUNT_BASED
        waitDurationInOpenState: 6s
  ratelimiter:
    instances:
      UserRateLimiter:
        limitForPeriod: 1
        limitRefreshPeriod: 10s
        timeoutDuration: 3s
  retry:
    instances:
      ratingHotelRetryService:
        maxAttempts: 5
        waitDuration: 1s
server:
  port: 8081
spring:
  application:
    name: user-service
  datasource:
    password: <YOUR_DB_PASSWORD>
    url: jdbc:mysql://localhost:3306/microservices_db
    username: root
  doc:
    swagger-ui:
      path: /swagger-ui.html
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
    show-sql: true
  security:
    oauth2:
      client:
        provider:
          okta:
            issuerUri: https://<YOUR_OKTA_DOMAIN>/oauth2/default
        registration:
          my-internal-client:
            authorizationGrantType: client_credentials
            clientId: <YOUR_OKTA_CLIENT_ID>
            clientSecret: <YOUR_OKTA_CLIENT_SECRET>
            provider: okta
            scope: internal
      resourceserver:
        jwt:
          issuer-uri: https://<YOUR_OKTA_DOMAIN>/oauth2/default
